{
  "name": "amazon-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Niche-agnostic Amazon product radar: YAML watchlists, daily Rainforest snapshots into Supabase Postgres.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "tsx src/db.ts migrate",
    "sync": "tsx bin/sync-watchlists.ts",
    "snapshot": "tsx bin/snapshot.ts",
    "leaderboard": "tsx bin/run-leaderboard.ts",
    "search": "tsx bin/run-search.ts",
    "category": "tsx bin/run-category.ts",
    "typecheck": "tsc --noEmit",
    "web": "npm --prefix web run dev"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.13.1",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
