# Rainforest API key — https://www.rainforestapi.com/
RAINFOREST_API_KEY=

# Supabase Postgres — Project Settings → Database → Session pooler (port 5432)
# Append ?sslmode=require
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Default Amazon marketplace if not overridden by watchlist or per-ASIN entry
AMAZON_DOMAIN=amazon.com

# Concurrency for product snapshot run
FETCH_CONCURRENCY=5
